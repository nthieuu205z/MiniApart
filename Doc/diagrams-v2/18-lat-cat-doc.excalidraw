{"type":"text","id":"t6","x":400,"y":682,"width":800,"height":45,"text":"Lát cắt 6 — Cổng người thuê\nKhông khởi động được nếu CR-001 chưa xong · kiểm thử theo hướng tấn công  ·  7 FR","originalText":"Lát cắt 6 — Cổng người thuê\nKhông khởi động được nếu CR-001 chưa xong · kiểm thử theo hướng tấn công  ·  7 FR","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e293b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":180161,"version":1,"versionNonce":161,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

