{"type":"text","id":"t1","x":400,"y":272,"width":800,"height":45,"text":"Lát cắt 1 — Danh mục toà nhà, phòng, dịch vụ\nBảng giá lưu nhiều phiên bản theo ngày hiệu lực ngay từ đầu  ·  7 FR","originalText":"Lát cắt 1 — Danh mục toà nhà, phòng, dịch vụ\nBảng giá lưu nhiều phiên bản theo ngày hiệu lực ngay từ đầu  ·  7 FR","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e293b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":180111,"version":1,"versionNonce":111,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

